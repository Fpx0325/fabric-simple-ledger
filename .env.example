# Copy to .env; replace every placeholder. Load using: set -a; source .env; set +a
API_TOKEN=replace-with-at-least-32-random-characters
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
MYSQL_DSN='ledger:replace-with-random-password@tcp(127.0.0.1:3306)/ledger?charset=utf8mb4&timeout=5s&readTimeout=5s&writeTimeout=5s'
HTTP_ADDR=127.0.0.1:8080
